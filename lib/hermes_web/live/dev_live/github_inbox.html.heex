<%!-- Greeting header --%>
<div class="flex items-end justify-between gap-5 mb-5 pt-6">
  <div>
    <div class="flex items-center gap-2">
      <h1 class="text-[28px] font-bold text-primary tracking-tight leading-tight">
        GitHub Fake Inbox
      </h1>
      <span class="inline-flex items-center text-[10px] font-semibold px-2 py-0.5 rounded-full bg-warning/15 text-warning uppercase tracking-[0.08em]">
        Dev
      </span>
    </div>
    <p class="text-[13px] text-base-content/50 font-medium mt-1.5">
      Issues created by the in-memory adapter. Toggle state to simulate a GitHub-side change.
    </p>
  </div>
  <button
    type="button"
    phx-click="reset"
    data-confirm="Wipe all fake issues?"
    class="det-btn det-btn-danger"
  >
    <.icon name="hero-trash" class="size-3.5" /> Reset
  </button>
</div>

<%= if @adapter != Hermes.Services.GitHub.InMemory do %>
  <div class="bg-warning/10 border border-warning/30 rounded-2xl px-[22px] py-4 text-[12.5px] text-warning font-medium flex items-start gap-2">
    <.icon name="hero-exclamation-triangle" class="size-4 shrink-0 mt-0.5" />
    <span>
      The configured GitHub adapter is <code class="font-mono text-[11.5px]">{inspect(@adapter)}</code>. This page only renders the
      in-memory adapter. Unset <code class="font-mono text-[11.5px]">GITHUB_USE_REAL_API</code>
      and restart the server to use it.
    </span>
  </div>
<% else %>
  <%!-- Project board items --%>
  <%= if @items != [] do %>
    <div class="bg-base-200 rounded-2xl overflow-hidden shadow-sm border border-base-300 mb-[18px]">
      <div class="px-[22px] py-4 border-b border-base-300 flex items-center gap-2 text-[13px] font-semibold text-base-content">
        <.icon name="hero-view-columns" class="size-4 text-base-content/40" /> Project board items
        <span class="ml-auto text-base-content/50 font-medium text-[11.5px]">
          {length(@items)} {if length(@items) == 1, do: "item", else: "items"}
        </span>
      </div>
      <table class="w-full border-collapse">
        <thead>
          <tr>
            <th class="px-[22px] py-3.5 text-left text-[10.5px] font-semibold uppercase tracking-[0.08em] text-base-content/50 border-b border-base-300 whitespace-nowrap">
              Item
            </th>
            <th class="px-[22px] py-3.5 text-left text-[10.5px] font-semibold uppercase tracking-[0.08em] text-base-content/50 border-b border-base-300 whitespace-nowrap">
              Issue node
            </th>
            <th class="px-[22px] py-3.5 text-left text-[10.5px] font-semibold uppercase tracking-[0.08em] text-base-content/50 border-b border-base-300 whitespace-nowrap">
              Current status
            </th>
            <th class="px-[22px] py-3.5 text-left text-[10.5px] font-semibold uppercase tracking-[0.08em] text-base-content/50 border-b border-base-300 whitespace-nowrap">
              Move to
            </th>
          </tr>
        </thead>
        <tbody>
          <%= for item <- @items do %>
            <tr class="border-b border-base-300 last:border-0 hover:bg-base-300/50 transition-colors">
              <td class="px-[22px] py-4">
                <code class="font-mono text-[11px] text-base-content/60 bg-base-300 rounded px-1.5 py-0.5">
                  {item.id}
                </code>
              </td>
              <td class="px-[22px] py-4">
                <code class="font-mono text-[11px] text-base-content/60 bg-base-300 rounded px-1.5 py-0.5">
                  {item.content_node_id}
                </code>
              </td>
              <td class="px-[22px] py-4">
                <code class="font-mono text-[11px] text-base-content/60 bg-base-300 rounded px-1.5 py-0.5">
                  {item.status_option_id || "(none)"}
                </code>
              </td>
              <td class="px-[22px] py-4">
                <div class="flex flex-wrap gap-1.5">
                  <%= for opt <- @options do %>
                    <button
                      type="button"
                      phx-click="move_card"
                      phx-value-item_id={item.id}
                      phx-value-option_id={opt.id}
                      phx-value-option_name={opt.name}
                      class={[
                        "det-btn",
                        item.status_option_id == opt.id && "det-btn-primary-solid"
                      ]}
                    >
                      {opt.name}
                    </button>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <%!-- Fake issues --%>
  <%= if @issues == [] do %>
    <div class="bg-base-200 rounded-2xl shadow-sm border border-base-300 text-center py-12 text-base-content/50">
      <.icon name="hero-inbox-stack" class="size-10 mx-auto mb-3 opacity-40" />
      <p class="text-[12.5px] font-medium">No fake issues yet. Create a Hermes request.</p>
    </div>
  <% else %>
    <div class="space-y-[18px]">
      <%= for issue <- @issues do %>
        <div class="bg-base-200 rounded-2xl shadow-sm border border-base-300 p-[22px]">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <h2 class="text-[14px] font-semibold text-base-content tracking-tight">
                {issue.owner}/{issue.repo}#{issue.number} — {issue.title}
              </h2>
              <p class="text-[11.5px] text-base-content/50 font-medium mt-1">
                Created {Calendar.strftime(issue.created_at, "%Y-%m-%d %H:%M:%S")} ·
                Updated {Calendar.strftime(issue.updated_at, "%Y-%m-%d %H:%M:%S")}
              </p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class={[
                "inline-flex items-center gap-1.5 text-[11px] font-semibold px-2.5 py-1 rounded-full",
                if(issue.state == "open",
                  do: "bg-success/15 text-success",
                  else: "bg-base-300 text-base-content/60"
                )
              ]}>
                <span class={[
                  "inline-block w-2 h-2 rounded-full",
                  if(issue.state == "open", do: "bg-success", else: "bg-base-content/30")
                ]} />
                {issue.state}
              </span>
              <button
                type="button"
                phx-click="toggle_state"
                phx-value-owner={issue.owner}
                phx-value-repo={issue.repo}
                phx-value-number={issue.number}
                class="det-btn"
              >
                <.icon name="hero-arrow-path" class="size-3.5" /> Toggle state
              </button>
            </div>
          </div>

          <%= if issue.labels != [] do %>
            <div class="flex flex-wrap gap-1.5 mt-3">
              <%= for label <- issue.labels do %>
                <span class="inline-flex items-center text-[10.5px] font-medium px-2 py-0.5 rounded-full bg-base-300 text-base-content/70">
                  {label}
                </span>
              <% end %>
            </div>
          <% end %>

          <details class="mt-3 group">
            <summary class="text-[12px] font-medium text-base-content/70 cursor-pointer list-none flex items-center gap-1.5 hover:text-base-content">
              <.icon
                name="hero-chevron-right"
                class="size-3.5 transition-transform group-open:rotate-90"
              /> Body
            </summary>
            <pre class="font-mono text-[11px] whitespace-pre-wrap mt-2 bg-base-300/60 text-base-content/80 p-3 rounded-lg">{issue.body}</pre>
          </details>

          <%= if issue.comments != [] do %>
            <div class="mt-4 pt-4 border-t border-base-300">
              <h3 class="text-[11px] font-semibold uppercase tracking-[0.08em] text-base-content/50">
                Comments ({length(issue.comments)})
              </h3>
              <ul class="mt-2.5 space-y-2.5">
                <%= for comment <- issue.comments do %>
                  <li class="border-l-2 border-base-300 pl-3">
                    <p class="text-[10.5px] text-base-content/50 font-medium">
                      {Calendar.strftime(comment.inserted_at, "%Y-%m-%d %H:%M:%S")}
                    </p>
                    <pre class="font-mono text-[11.5px] whitespace-pre-wrap text-base-content/80 mt-1">{comment.body}</pre>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
