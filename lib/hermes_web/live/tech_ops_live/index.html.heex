<%!-- Header --%>
<div class="flex items-end justify-between gap-5 mb-5 pt-6">
  <div>
    <h1 class="text-[28px] font-bold text-primary tracking-tight leading-tight">
      {gettext("Tech Ops")}
    </h1>
    <p class="text-[13px] text-base-content/50 font-medium mt-1.5">
      {gettext("Log of tech ops issues and tasks")}
    </p>
  </div>
  <div class="flex items-center gap-2">
    <button type="button" phx-click="open_new_modal" class="det-btn det-btn-primary-solid">
      <.icon name="hero-plus" class="size-3.5" />{gettext("Record task")}
    </button>
  </div>
</div>

<%!-- Tasks table card --%>
<div class="bg-base-200 rounded-2xl overflow-hidden shadow-sm border border-base-300">
  <div class="px-[22px] py-4 border-b border-base-300 flex items-center gap-2 text-[13px] font-semibold text-base-content">
    <.icon name="hero-wrench-screwdriver" class="size-4 text-base-content/40" />
    {gettext("Tasks")}
    <span class="ml-auto text-base-content/50 font-medium text-[11.5px]">
      {ngettext("%{count} task", "%{count} tasks", @task_count, count: @task_count)}
    </span>
  </div>
  <div class="overflow-x-auto">
    <table class="min-w-max w-full border-collapse">
      <thead>
        <tr>
          <th class="px-[22px] py-3.5 text-left text-[10.5px] font-semibold uppercase tracking-[0.08em] text-base-content/50 border-b border-base-300 whitespace-nowrap min-w-[7rem]">
            {gettext("Date")}
          </th>
          <th class="px-[22px] py-3.5 text-left text-[10.5px] font-semibold uppercase tracking-[0.08em] text-base-content/50 border-b border-base-300 min-w-[18rem]">
            {gettext("Reported problem")}
          </th>
          <th class="px-[22px] py-3.5 text-left text-[10.5px] font-semibold uppercase tracking-[0.08em] text-base-content/50 border-b border-base-300 min-w-[10rem]">
            {gettext("Reporter")}
          </th>
          <th class="px-[22px] py-3.5 text-left text-[10.5px] font-semibold uppercase tracking-[0.08em] text-base-content/50 border-b border-base-300 min-w-[12rem]">
            {gettext("Issue origin")}
          </th>
          <th class="px-[22px] py-3.5 text-left text-[10.5px] font-semibold uppercase tracking-[0.08em] text-base-content/50 border-b border-base-300 min-w-[10rem]">
            {gettext("Responsible")}
          </th>
          <th class="px-[22px] py-3.5 text-left text-[10.5px] font-semibold uppercase tracking-[0.08em] text-base-content/50 border-b border-base-300 min-w-[8rem]">
            {gettext("Status")}
          </th>
          <th class="px-[22px] py-3.5 text-left text-[10.5px] font-semibold uppercase tracking-[0.08em] text-base-content/50 border-b border-base-300 min-w-[18rem]">
            {gettext("Resolution")}
          </th>
          <th class="px-[22px] py-3.5 text-left text-[10.5px] font-semibold uppercase tracking-[0.08em] text-base-content/50 border-b border-base-300 min-w-[10rem]">
            {gettext("Team")}
          </th>
          <th class="px-[22px] py-3.5 text-left text-[10.5px] font-semibold uppercase tracking-[0.08em] text-base-content/50 border-b border-base-300 min-w-[16rem]">
            {gettext("Cause")}
          </th>
          <th class="sticky right-0 z-10 bg-base-200 px-[22px] py-3.5 border-b border-l border-base-300 shadow-[-8px_0_12px_-8px_rgba(0,0,0,0.25)]">
          </th>
        </tr>
      </thead>
      <tbody id="tech-ops-tasks" phx-update="stream">
        <tr id="tech-ops-tasks-empty" class="only:table-row hidden">
          <td colspan="10" class="px-[22px] py-10 text-center text-[12.5px] text-base-content/50">
            {gettext("No tasks recorded yet.")}
          </td>
        </tr>
        <%= for {dom_id, task} <- @streams.tasks do %>
          <tr
            id={dom_id}
            class="group border-b border-base-300 last:border-0 hover:bg-base-300 transition-colors align-middle"
          >
            <td class="px-[22px] py-4 text-[12.5px] text-base-content/70 whitespace-nowrap min-w-[7rem]">
              {Calendar.strftime(task.recorded_on, "%Y-%m-%d")}
            </td>
            <td class="px-[22px] py-4 text-[12.5px] font-medium text-base-content min-w-[18rem]">
              <div class="whitespace-pre-line" phx-no-format>{task.reported_problem}</div>
            </td>
            <td class="px-[22px] py-4 text-[12.5px] text-base-content/70 min-w-[10rem]">
              {if task.reporter, do: task.reporter.name, else: "—"}
            </td>
            <td class="px-[22px] py-4 text-[12.5px] text-base-content/70 min-w-[12rem]">
              {if task.issue_origin, do: task.issue_origin.name, else: "—"}
            </td>
            <td class="px-[22px] py-4 text-[12.5px] text-base-content/70 whitespace-nowrap min-w-[10rem]">
              {if task.responsible,
                do: Hermes.Accounts.User.display_name(task.responsible),
                else: "—"}
            </td>
            <td class="px-[22px] py-4 whitespace-nowrap min-w-[8rem]">
              <span class={[
                "inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-semibold",
                task_status_badge_class(task.status)
              ]}>
                {task_status_label(task.status)}
              </span>
            </td>
            <td class="px-[22px] py-4 text-[12.5px] text-base-content/70 min-w-[18rem]">
              <div
                :if={task.resolution not in [nil, ""]}
                class="whitespace-pre-line"
                phx-no-format
              >{task.resolution}</div>
              <span :if={task.resolution in [nil, ""]}>—</span>
            </td>
            <td class="px-[22px] py-4 text-[12.5px] text-base-content/70 whitespace-nowrap min-w-[10rem]">
              {if task.team, do: task.team.name, else: "—"}
            </td>
            <td class="px-[22px] py-4 text-[12.5px] text-base-content/70 min-w-[16rem]">
              <div :if={task.cause not in [nil, ""]} class="whitespace-pre-line" phx-no-format>{task.cause}</div>
              <span :if={task.cause in [nil, ""]}>—</span>
            </td>
            <td class="sticky right-0 z-10 bg-base-200 group-hover:bg-base-300 px-[22px] py-4 text-right whitespace-nowrap border-l border-base-300 shadow-[-8px_0_12px_-8px_rgba(0,0,0,0.25)] transition-colors">
              <button
                type="button"
                phx-click="open_edit_modal"
                phx-value-id={task.id}
                class="det-btn"
              >
                {gettext("Edit")}
              </button>
              <button
                type="button"
                phx-click="open_delete_modal"
                phx-value-id={task.id}
                class="det-btn det-btn-danger"
              >
                <.icon name="hero-trash" class="size-3.5" />
              </button>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%!-- Form modal (create / edit) --%>
<%= if @show_form_modal do %>
  <div class="app-modal items-start overflow-y-auto pt-24 pb-16">
    <div class="app-modal-box my-auto" phx-click-away="close_form_modal">
      <div class="app-modal-title">
        {if @form_mode == :new, do: gettext("Record task"), else: gettext("Edit task")}
      </div>
      <div class="app-modal-sub">
        {if @form_mode == :new,
          do: gettext("Log a new tech ops issue or task."),
          else: gettext("Update the task details below.")}
      </div>

      <.form for={@form} id="tech-ops-task-form" phx-change="validate" phx-submit="save">
        <div class="space-y-4">
          <.input field={@form[:recorded_on]} type="date" label={gettext("Date")} required />
          <.input
            field={@form[:reported_problem]}
            type="textarea"
            label={gettext("Reported problem")}
            required
          />
          <div class="fieldset mb-2">
            <span class="label mb-1">{gettext("Reporter")}</span>
            <div class="flex items-start gap-2">
              <%= if @new_reporter do %>
                <input
                  type="text"
                  name="task[reporter_name]"
                  value={@reporter_name}
                  list="tech-ops-reporters"
                  autocomplete="off"
                  placeholder={gettext("Type a new one")}
                  class="flex-1 input"
                />
                <datalist id="tech-ops-reporters">
                  <option :for={r <- @reporters} value={r.name}></option>
                </datalist>
              <% else %>
                <select name="task[reporter_name]" class="flex-1 select">
                  <option value="">{gettext("Unassigned")}</option>
                  <option
                    :for={r <- @reporters}
                    value={r.name}
                    selected={r.name == @reporter_name}
                  >
                    {r.name}
                  </option>
                </select>
              <% end %>
              <button
                type="button"
                class="btn btn-ghost btn-sm"
                phx-click="toggle_new_lookup"
                phx-value-field="reporter"
                title={if @new_reporter, do: gettext("Pick existing"), else: gettext("Add new")}
              >
                {if @new_reporter, do: gettext("Cancel"), else: gettext("+ New")}
              </button>
            </div>
          </div>
          <div class="fieldset mb-2">
            <span class="label mb-1">{gettext("Issue origin")}</span>
            <div class="flex items-start gap-2">
              <%= if @new_issue_origin do %>
                <input
                  type="text"
                  name="task[issue_origin_name]"
                  value={@issue_origin_name}
                  list="tech-ops-issue-origins"
                  autocomplete="off"
                  placeholder={gettext("Type a new one")}
                  class="flex-1 input"
                />
                <datalist id="tech-ops-issue-origins">
                  <option :for={o <- @issue_origins} value={o.name}></option>
                </datalist>
              <% else %>
                <select name="task[issue_origin_name]" class="flex-1 select">
                  <option value="">{gettext("Unassigned")}</option>
                  <option
                    :for={o <- @issue_origins}
                    value={o.name}
                    selected={o.name == @issue_origin_name}
                  >
                    {o.name}
                  </option>
                </select>
              <% end %>
              <button
                type="button"
                class="btn btn-ghost btn-sm"
                phx-click="toggle_new_lookup"
                phx-value-field="issue_origin"
                title={
                  if @new_issue_origin, do: gettext("Pick existing"), else: gettext("Add new")
                }
              >
                {if @new_issue_origin, do: gettext("Cancel"), else: gettext("+ New")}
              </button>
            </div>
          </div>
          <.input
            field={@form[:responsible_id]}
            type="select"
            label={gettext("Tech ops responsible")}
            prompt={gettext("Unassigned")}
            options={Enum.map(@users, &{Hermes.Accounts.User.display_name(&1), &1.id})}
          />
          <.input
            field={@form[:status]}
            type="select"
            label={gettext("Status")}
            options={task_status_options()}
            required
          />
          <.input field={@form[:resolution]} type="textarea" label={gettext("Resolution")} />
          <.input
            field={@form[:team_id]}
            type="select"
            label={gettext("Team")}
            prompt={gettext("No team")}
            options={Enum.map(@teams, &{&1.name, &1.id})}
          />
          <.input field={@form[:cause]} type="textarea" label={gettext("Cause")} />
        </div>

        <div class="app-modal-foot">
          <button type="button" phx-click="close_form_modal" class="det-btn">
            {gettext("Cancel")}
          </button>
          <button
            type="submit"
            class="det-btn det-btn-primary-solid"
            phx-disable-with={gettext("Saving...")}
          >
            {if @form_mode == :new, do: gettext("Record Task"), else: gettext("Save Changes")}
          </button>
        </div>
      </.form>
    </div>
  </div>
<% end %>

<%!-- Delete confirmation modal --%>
<%= if @show_delete_modal do %>
  <div class="app-modal">
    <div class="app-modal-box max-w-sm" phx-click-away="close_delete_modal">
      <div class="app-modal-title">{gettext("Confirm Deletion")}</div>
      <div class="app-modal-sub">
        {gettext("Are you sure you want to delete this task? This action cannot be undone.")}
      </div>
      <div class="app-modal-foot">
        <button type="button" phx-click="close_delete_modal" class="det-btn">
          {gettext("Cancel")}
        </button>
        <button type="button" phx-click="confirm_delete" class="det-btn det-btn-danger-solid">
          {gettext("Delete Task")}
        </button>
      </div>
    </div>
  </div>
<% end %>
