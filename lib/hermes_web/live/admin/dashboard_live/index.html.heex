<%!-- Greeting header --%>
<div class="flex items-end justify-between gap-5 mb-5 pt-6">
  <div>
    <h1 class="text-[28px] font-bold text-primary tracking-tight leading-tight">
      {gettext("Admin Dashboard")}
    </h1>
    <p class="text-[13px] text-base-content/50 font-medium mt-1.5">
      {gettext("System overview and management")}
    </p>
  </div>
  <div class="flex items-center gap-2">
    <.link navigate={~p"/admin/users"} class="det-btn">
      <.icon name="hero-users" class="size-3.5" />{gettext("Manage users")}
    </.link>
    <.link navigate={~p"/admin/teams"} class="det-btn">
      <.icon name="hero-user-group" class="size-3.5" />{gettext("Manage teams")}
    </.link>
    <.link navigate={~p"/admin/github"} class="det-btn">
      <.icon name="hero-arrow-path" class="size-3.5" />{gettext("GitHub mappings")}
    </.link>
    <.link navigate={~p"/admin/api-tokens"} class="det-btn">
      <.icon name="hero-key" class="size-3.5" />{gettext("API tokens")}
    </.link>
  </div>
</div>

<%!-- Statistics cards --%>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-[18px] mb-[18px]">
  <div class="bg-base-200 rounded-2xl shadow-sm border border-base-300 p-[22px]">
    <div class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-base-content/50">
      <.icon name="hero-user-group" class="size-3.5" />{gettext("Total Users")}
    </div>
    <div class="text-[30px] font-bold text-base-content tracking-tight mt-2.5 leading-none">
      {@total_users}
    </div>
    <div class="text-[11.5px] text-base-content/50 font-medium mt-2">
      {gettext("Registered users in the system")}
    </div>
  </div>

  <div class="bg-base-200 rounded-2xl shadow-sm border border-base-300 p-[22px]">
    <div class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-base-content/50">
      <.icon name="hero-rectangle-group" class="size-3.5" />{gettext("Teams")}
    </div>
    <div class="text-[30px] font-bold text-base-content tracking-tight mt-2.5 leading-none">
      {@total_teams}
    </div>
    <div class="text-[11.5px] text-base-content/50 font-medium mt-2">
      {gettext("Active teams")}
    </div>
  </div>

  <div class="bg-base-200 rounded-2xl shadow-sm border border-base-300 p-[22px]">
    <div class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-base-content/50">
      <.icon name="hero-shield-check" class="size-3.5" />{gettext("Administrators")}
    </div>
    <div class="text-[30px] font-bold text-base-content tracking-tight mt-2.5 leading-none">
      {@admin_users}
    </div>
    <div class="text-[11.5px] text-base-content/50 font-medium mt-2">
      {gettext("System admins")}
    </div>
  </div>

  <div class="bg-base-200 rounded-2xl shadow-sm border border-base-300 p-[22px]">
    <div class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-base-content/50">
      <.icon name="hero-inbox-stack" class="size-3.5" />{gettext("Total Requests")}
    </div>
    <div class="text-[30px] font-bold text-base-content tracking-tight mt-2.5 leading-none">
      {@total_requests}
    </div>
    <div class="text-[11.5px] text-base-content/50 font-medium mt-2">
      {gettext("All requests in the system")}
    </div>
  </div>
</div>

<%!-- User activity (real-time & last 7 days) --%>
<div class="bg-base-200 rounded-2xl overflow-hidden shadow-sm border border-base-300">
  <div class="px-[22px] py-4 border-b border-base-300 flex items-center gap-2 text-[13px] font-semibold text-base-content">
    <.icon name="hero-signal" class="size-4 text-base-content/40" />
    {gettext("User Activity")}
    <div class="ml-auto flex items-center gap-2">
      <span class="inline-flex items-center gap-2 text-[11px] font-semibold px-2.5 py-1 rounded-full bg-success/15 text-success">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75">
          </span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-success"></span>
        </span>
        {online_count = @users |> Map.values() |> Enum.count(& &1.online)
        ngettext("%{count} online", "%{count} online", online_count, count: online_count)}
      </span>
      <span class="inline-flex items-center text-[11px] font-semibold px-2.5 py-1 rounded-full bg-base-300 text-base-content/60">
        {gettext("Last 7 days")}
      </span>
    </div>
  </div>

  <%= if map_size(@users) == 0 do %>
    <div class="text-center py-12 text-base-content/50">
      <.icon name="hero-users" class="size-10 mx-auto mb-3 opacity-40" />
      <p class="text-[12.5px] font-medium">{gettext("No recent user activity")}</p>
    </div>
  <% else %>
    <table class="w-full border-collapse">
      <thead>
        <tr>
          <th class="px-[22px] py-3.5 text-left text-[10.5px] font-semibold uppercase tracking-[0.08em] text-base-content/50 border-b border-base-300 whitespace-nowrap">
            {gettext("User")}
          </th>
          <th class="px-[22px] py-3.5 text-left text-[10.5px] font-semibold uppercase tracking-[0.08em] text-base-content/50 border-b border-base-300 whitespace-nowrap">
            {gettext("Role")}
          </th>
          <th class="px-[22px] py-3.5 text-left text-[10.5px] font-semibold uppercase tracking-[0.08em] text-base-content/50 border-b border-base-300 whitespace-nowrap">
            {gettext("Current View")}
          </th>
          <th class="px-[22px] py-3.5 text-left text-[10.5px] font-semibold uppercase tracking-[0.08em] text-base-content/50 border-b border-base-300 whitespace-nowrap">
            {gettext("Status")}
          </th>
          <th class="px-[22px] py-3.5 text-left text-[10.5px] font-semibold uppercase tracking-[0.08em] text-base-content/50 border-b border-base-300 whitespace-nowrap">
            {gettext("Last Seen")}
          </th>
        </tr>
      </thead>
      <tbody id="users-list" phx-update="stream">
        <%= for {_id, user} <- @users |> Enum.sort_by(fn {_, u} ->
          timestamp = if u.last_seen_at, do: DateTime.to_unix(u.last_seen_at), else: 0
          {!u.online, -timestamp}
        end) do %>
          <tr
            id={"user-#{user.id}"}
            class="border-b border-base-300 last:border-0 hover:bg-base-300/50 transition-colors"
          >
            <td class="px-[22px] py-4 whitespace-nowrap">
              <div class="flex items-center gap-3">
                <img
                  src={"https://api.dicebear.com/7.x/avataaars/svg?seed=#{user.id}"}
                  alt={user.display_name}
                  class="w-9 h-9 rounded-full bg-base-300 ring-1 ring-base-300"
                />
                <span class="min-w-0">
                  <span class="block text-[12.5px] font-medium text-base-content truncate">
                    {user.display_name}
                  </span>
                  <span class="block text-[11px] text-base-content/50 truncate">
                    {user.email}
                  </span>
                </span>
              </div>
            </td>
            <td class="px-[22px] py-4 text-[12.5px] text-base-content/70 whitespace-nowrap">
              {role_label(user.role)}
            </td>
            <td class="px-[22px] py-4 text-[12.5px] text-base-content/70">
              <%= if user.current_view do %>
                <span class="inline-flex items-center gap-1.5">
                  <.icon name="hero-document-text" class="size-3.5 text-base-content/40" />
                  {user.current_view}
                </span>
              <% else %>
                <span class="text-base-content/30">—</span>
              <% end %>
            </td>
            <td class="px-[22px] py-4 text-[12.5px] whitespace-nowrap">
              <%= if user.online do %>
                <span class="inline-flex items-center gap-2 text-success font-medium">
                  <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75">
                    </span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-success"></span>
                  </span>
                  {gettext("Online")}
                </span>
              <% else %>
                <span class="inline-flex items-center gap-2 text-base-content/50">
                  <span class="inline-block w-2 h-2 rounded-full bg-base-content/30"></span>
                  {gettext("Offline")}
                </span>
              <% end %>
            </td>
            <td class="px-[22px] py-4 text-[12.5px] text-base-content/60 whitespace-nowrap">
              {format_last_seen(user.last_seen_at)}
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
